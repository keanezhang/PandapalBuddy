"""pandaren/llm/providers/_template.py.example — 新增 provider typed extra 模板

⚠️ 这是一个 .example 文件，不会被 Python 加载。
   要新增一家 provider 的 typed extra 时：
     1. 复制本文件到 providers/<platform_name>.py
        （文件名用**平台名**，比如 providers/moonshot.py，而不是品牌名 providers/kimi.py）
     2. 按下方 [TODO] 注释逐项替换
     3. 参考已有实现：providers/dashscope.py（阿里云百炼，跑 Qwen）、
        providers/volcengine.py（火山引擎方舟，跑 Doubao）

完整加 provider 流程见 pandaren/llm/ADDING_A_PROVIDER.md。

─── 什么情况下需要写这个文件？───────────────────────────────
只在新 provider 有**裸 dict 才能传的非标字段**时才需要写 Extra。
判断标准：
  ✓ 有专属 extra_body 字段（比如 moonshot 的 partial、builtin_function）
    → 写一个 XExtra dataclass（本文件）
  ✗ 这家完全走标准 OpenAI 字段，没任何专属参数
    → 不用写，使用者直接用 ModelSettings 就够了

─── 设计原则（和 dashscope.py / volcengine.py 保持一致）──────
  - L3 透传：字段名 1:1 对齐 provider 官方文档，**不做映射、不抹平语义**
  - 所有字段默认 None = 不传（让 provider 用自己的默认值）
  - 提供 as_extra_body() 把 dataclass 还原为 OpenAI 能吃的 dict 顶层字段
  - 提供 raw 逃生舱口，SDK 未跟进的新字段可以先塞进去
  - 不覆盖 message 级字段（比如 cache_control 挂在 content 块里，不属于 extra_body）
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Literal


# ═══════════════════════════════════════════════════════════════
# 类型别名（如果有枚举型字段）
# ═══════════════════════════════════════════════════════════════

# [TODO] 如果 provider 有枚举字段，在这里声明 Literal 类型别名
# 删掉本块如果不需要

ExampleMode = Literal["mode_a", "mode_b", "auto"]
"""示例枚举字段的合法取值。

- "mode_a": ...
- "mode_b": ...
- "auto":   ...
"""


# ═══════════════════════════════════════════════════════════════
# {PROVIDER} Extra 主结构
# ═══════════════════════════════════════════════════════════════

@dataclass
class TemplateExtra:  # [TODO] 改成 {Platform}Extra（平台名），比如 MoonshotExtra（而不是品牌名 KimiExtra）
    """{Provider} OpenAI 兼容 /chat/completions 端点的专属参数（透传不映射）。

    字段全部对应 {Provider} 官方文档原名，SDK 不做任何重命名或语义转换。

    对应官方文档：
      # [TODO] 贴上这家的官方文档链接
      - 深度思考:   https://...
      - 上下文缓存: https://...
      - 联网搜索:   https://...

    典型用法
    ────────────────────────────────────────────────────────────
    # [TODO] 替换成这家真实的用法示例

    # 1) 关闭某能力
    {Provider}Extra(some_toggle=False)

    # 2) 带参数
    {Provider}Extra(some_mode="mode_a", some_budget=4096)

    # 3) 组合
    {Provider}Extra(
        some_toggle=True,
        some_budget=8192,
    )

    ⚠️ 注意
    ────────────────────────────────────────────────────────────
    # [TODO] 列出本家的坑和边界条件，例如：
    - xxx 字段只对 {模型系列} 有效，其他模型会被服务端忽略
    - 本结构**不包含** xxx —— 该字段是 message 级而非请求级参数
    """

    # ─── [TODO] 第一类能力（例如思考控制）─────────────────────
    some_toggle: bool | None = None
    """某开关的说明。对应 body: {"some_toggle": <bool>}。

    - None (默认): 不传该字段，用模型自身默认值
    - True:        强制开启
    - False:       强制关闭
    """

    some_budget: int | None = None
    """某数值上限。对应 body: {"some_budget": <int>}。

    - None (默认): 不传
    - 正整数:      上限值
    """

    some_mode: ExampleMode | None = None
    """某枚举字段。对应 body: {"some_field": {"type": "<mode>"}}（嵌套）
    或 body: {"some_mode": "<mode>"}（扁平，按 provider 协议而定）。
    """

    # ─── [TODO] 第二类能力（例如联网搜索）─────────────────────
    # 照上面的模式继续加

    # ─── 逃生舱口（**所有 Extra 都要保留**）────────────────────
    raw: dict[str, Any] = field(default_factory=dict)
    """原样塞入 body 顶层的逃生舱口。

    如果 {Provider} 新加了一个字段，而本 dataclass 还没来得及跟进，
    可以先塞进这里——`as_extra_body()` 会把 raw 原样 merge 到输出 dict 里。
    字段 typed 化后应移出 raw。
    """

    def as_extra_body(self) -> dict[str, Any]:
        """把 typed 字段还原成 OpenAI 兼容的 payload 顶层 dict。

        输出示例：
            # [TODO] 替换成这家真实的输出结构
            TemplateExtra(some_toggle=True, some_budget=4096).as_extra_body()
            → {"some_toggle": True, "some_budget": 4096}

        None 值的字段不出现在输出中。`raw` 最后 merge（可覆盖 typed 字段的值）。
        """
        body: dict[str, Any] = {}

        # [TODO] 每个字段都要处理 None 分支，None 时不写入
        if self.some_toggle is not None:
            body["some_toggle"] = self.some_toggle

        if self.some_budget is not None:
            body["some_budget"] = self.some_budget

        # [TODO] 嵌套字段的处理示例（火山方舟 thinking_mode → {"thinking": {"type": ...}}）
        if self.some_mode is not None:
            body["some_field"] = {"type": self.some_mode}

        # [TODO] 扁平字段的处理示例（火山方舟 reasoning_effort 直接扁平）
        # if self.some_level is not None:
        #     body["some_level"] = self.some_level

        # raw 兜底覆盖（逃生舱口）—— 所有 Extra 都要保留这一段
        if self.raw:
            body.update(self.raw)

        return body
