# ── 存储路径：开发用项目根 .pandapal（方便调试）──
PANDAPAL_DATA_DIR=.pandapal

# ── 系统配置（必填项）──
# Relay 服务器 WebSocket 地址（本地调试可指向本地 relay 或留空）
PANDAPAL_RELAY_URL=wss://your-relay-domain.com/relay/ws
# Relay 认证 token（与 relay 端配置保持一致）
PANDAPAL_RELAY_AUTH_TOKEN=your-relay-auth-token

# ── 网络搜索工具 ──
WEB_SEARCH_PROVIDER=tavily     # tavily | bocha | serpapi
BOCHA_API_KEY=sk-your-key
TAVILY_API_KEY=tvly-your-key

# ── 数据保存方式 ──
PANDAPAL_STORAGE_MODE=markdown

# ── 渠道策略（fail-closed：未配置 = 拒绝）──
# source_only: 仅作为消息来源接收；target_only: 仅作为投递目标；both/deny
PANDAPAL_CHANNEL_DESKTOP_IPC_POLICY=source_only
PANDAPAL_CHANNEL_WECOM_POLICY=source_only
PANDAPAL_CHANNEL_XIAOZHI_POLICY=target_only
