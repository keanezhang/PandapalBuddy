# PandaPal Relay Server — 密钥模板
# 复制此文件为 .env（或 .env.development），填入真实值
#
# 规则：只放密钥和凭证，URL / 超时等行为参数住在 agent.yaml
# 配置说明见 pandapal_relay/README.md

# ── WeCom / 企业微信（可选：未配置 WECOM_CORP_ID 即禁用企微，服务器照常启动）──
#    启用则以下全部必填（fail-closed，防半配置静默失效）
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=1000000
WECOM_APP_SECRET=your-app-secret
WECOM_APP_MESSAGE_USERIDS=YourUserId   # 白名单（fail-closed）：未配置/为空=拒绝所有人
WECOM_DEFAULT_USER_ID=YourUserId       # 回包路由 user_id（必填，零兜底）：必须是白名单成员
WECOM_TOKEN=your-wecom-token
WECOM_AES_KEY=your-aes-key-43-chars

# ── XiaoZhi / 小智硬件（必填，若启用硬件端点）────────────────────
XIAOZHI_ENABLED=true
XIAOZHI_ASR_PROVIDER=qwen3-asr-flash-realtime
XIAOZHI_ASR_API_KEY=sk-your-key-here
XIAOZHI_TTS_PROVIDER=qwen3-tts-flash-realtime
XIAOZHI_TTS_API_KEY=sk-your-key-here

# ── Auth / 认证（必填）────────────────────────────────────────────
# JWT 签名密钥：必须与 sidecar 端 jwt_secret 保持一致
# sidecar 计算方式：agent.yaml relay.auth_token[:32] + "pandapal_jwt_secret"
AUTH_JWT_SECRET=your-jwt-secret-here
AUTH_DB_PATH=relay_auth.db

# ── 部署参数（环境相关，非密钥）──────────────────────────────────
RELAY_PORT=8090
